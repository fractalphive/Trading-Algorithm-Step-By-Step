# Copy this file to .env and fill in your own Alpaca paper keys.
# NEVER paste real keys into any tracked file, an Issue, or Discord.
# Get paper keys at https://app.alpaca.markets/ (free, no real money).

ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Use paper trading by default. Set to false only when you personally trust it.
PAPER=true
